# Public site URL — used for canonical links, OpenGraph, sitemap.xml and robots.txt.
# Set this to your deployment URL in Vercel.
NEXT_PUBLIC_SITE_URL=https://faultlines-kappa.vercel.app

# Analysis provider. 'mock' (default) runs the built-in deterministic
# heuristic — no key, no network. Anything else uses the OpenAI-compatible
# provider below. ALL of these are server-side only; never prefix with
# NEXT_PUBLIC_ (that would ship your key to every browser).
LLM_PROVIDER=mock

# --- Real provider (optional) ---
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# Works with any OpenAI-compatible endpoint (OpenRouter, Groq, Together,
# a local server...). If the provider fails, Fault Lines falls back to the
# heuristic and tells the teacher (meta.degraded).
